# ── Ziel: Waveshare ESP32-S3-Touch-LCD-7B (16 MB Flash, 8 MB OPI-PSRAM) ──────────
CONFIG_IDF_TARGET="esp32s3"

# Flash und PSRAM muessen auf gleicher Frequenz laufen (aus dem Projekt "zentralsteuerung", dort erprobt)
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_120M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_120M=y
# Code und Nur-Lese-Daten im PSRAM: Flash-Zugriffe (Schreiben!) halten Programm und Display nicht mehr an
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384

# ── Das Ziel dieses Builds: Display-Ansteuerung flash-sicher ────────────────────
CONFIG_LCD_RGB_ISR_IRAM_SAFE=y
CONFIG_GDMA_ISR_IRAM_SAFE=y
CONFIG_LCD_RGB_RESTART_IN_VSYNC=y

# ── Cache und Compiler ─────────────────────────────────────────────────────────
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000

# ── Partitionen: dieselbe Tabelle wie in der Arduino-IDE (kein OTA) ─────────────
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# ── Arduino als Komponente: setup()/loop() automatisch starten, Serial bleibt auf dem UART-Port ──
CONFIG_AUTOSTART_ARDUINO=y
CONFIG_ARDUINO_LOOP_STACK_SIZE=8192
CONFIG_ARDUINO_RUN_CORE1=y
CONFIG_ARDUINO_USB_CDC_ON_BOOT=n
CONFIG_ESP_CONSOLE_UART_DEFAULT=y


# ── LVGL: Konfiguration ueber lv_conf.h ──────────────────────────────────────────
CONFIG_LV_CONF_SKIP=n

# ── Fremdkomponenten (esp-modbus u. a.) brauchen in IDF 5.5 diese Lockerung der Warnungen-als-Fehler ──
CONFIG_COMPILER_DISABLE_DEFAULT_ERRORS=y

# ── USB-Geraet (HID-Tastatur + Consumer + CDC) ─────────────────────────────────
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1
CONFIG_TINYUSB_HID_COUNT=1
CONFIG_TINYUSB_SUSPEND_CALLBACK=y
CONFIG_TINYUSB_RESUME_CALLBACK=y
